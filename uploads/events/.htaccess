# Disable PHP execution in uploads directory (Practical 12 Security Requirement)
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|cgi|pl|exe|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevent script engine execution if mod_php is used
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
